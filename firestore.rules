rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }

    function isOwnerEmail() {
      return isSignedIn() && request.auth.token.email in ['info@mi-rheinservice.de'];
    }

    function nutzerDoc() {
      return get(/databases/$(database)/documents/nutzer/$(request.auth.uid)).data;
    }

    function isNutzerOwner() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/nutzer/$(request.auth.uid))
        && nutzerDoc().rolle == "Gesellschafter";
    }

    function isOwner() {
      return isOwnerEmail() || isNutzerOwner();
    }

    function myMitarbeiterId() {
      return nutzerDoc().mitarbeiterId;
    }

    function isActiveEmployee() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/nutzer/$(request.auth.uid))
        && nutzerDoc().rolle == "Mitarbeiter"
        && exists(/databases/$(database)/documents/mitarbeiter/$(myMitarbeiterId()))
        && get(/databases/$(database)/documents/mitarbeiter/$(myMitarbeiterId())).data.status == "Aktiv";
    }

    function isAssignedToMe() {
      return resource.data.mitarbeiterId == myMitarbeiterId();
    }

    // ---- Kunden & Objekte ----
    match /customers/{customerId} {
      allow read: if isOwner() || isActiveEmployee();
      allow write: if isOwner();

      match /objekte/{propertyId} {
        allow read: if isOwner() || isActiveEmployee();
        allow write: if isOwner();

        match /auftraege/{jobId} {
          allow read: if isOwner() || (isActiveEmployee() && isAssignedToMe());
          allow create, delete: if isOwner();
          allow update: if isOwner() || (
            isActiveEmployee() && isAssignedToMe() && resource.data.status != "Erledigt" &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'erledigtVon', 'erledigtAm'])
          );
        }

        match /wiederkehrend/{templateId} {
          allow read, write: if isOwner();
        }
      }

      match /dokumente/{docId} {
        allow read: if isOwner();
        allow create: if isOwner();
        allow update, delete: if isOwner() &&
          !(resource.data.typ == "Rechnung" && resource.data.status == "Storniert");
      }

      match /dateien/{fileId} {
        allow read, write: if isOwner();
      }

      match /wiedervorlagen/{followupId} {
        allow read, write: if isOwner();
      }
    }

    // ---- Mitarbeiter ----
    match /mitarbeiter/{employeeId} {
      allow read: if isOwner() || (isActiveEmployee() && employeeId == myMitarbeiterId());
      allow write: if isOwner();

      match /abwesenheiten/{absenceId} {
        allow read, write: if isOwner();
      }
    }

    // ---- Nutzer (Auth-Profile) ----
    match /nutzer/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn() && request.auth.uid == uid && (
        (isOwnerEmail() && request.resource.data.rolle == "Gesellschafter") ||
        (request.resource.data.rolle == "Mitarbeiter" && request.resource.data.mitarbeiterId is string && request.resource.data.mitarbeiterId != "")
      );
      allow update, delete: if false;
    }

    // ---- Katalog & Lager ----
    match /services/{serviceId} {
      allow read: if isOwner() || isActiveEmployee();
      allow write: if isOwner();
    }

    match /material/{materialId} {
      allow read: if isOwner() || isActiveEmployee();
      allow write: if isOwner();

      match /bewegungen/{movementId} {
        allow read, write: if isOwner();
      }
    }

    match /materialbestellungen/{orderId} {
      allow read: if isOwner() || (isActiveEmployee() && isAssignedToMe());
      allow create: if isOwner() || (
        isActiveEmployee() &&
        request.resource.data.mitarbeiterId == myMitarbeiterId() &&
        request.resource.data.status == "Offen"
      );
      allow update, delete: if isOwner();
    }

    // ---- Dokumentencenter: nicht zugeordnete Uploads ----
    match /unzugeordnete_dokumente/{fileId} {
      allow read, write: if isOwner();
    }

    // ---- Änderungsprotokoll (Audit-Log, unveränderlich) ----
    match /aenderungsprotokoll/{entryId} {
      allow read, create: if isOwner();
      allow update, delete: if false;
    }

    // ---- Steuern & Rücklagen, Kalkulatoren (nur Gesellschafter) ----
    match /ausgaben/{id} {
      allow read, write: if isOwner();
    }
    match /taxParameters/{id} {
      allow read, write: if isOwner();
    }
    match /taxProfiles/{id} {
      allow read, write: if isOwner();
    }
    match /taxDeadlines/{id} {
      allow read, write: if isOwner();
    }
    match /employeeCostProfiles/{id} {
      allow read, write: if isOwner();
    }
    match /objectCalculations/{id} {
      allow read, write: if isOwner();
    }

    // ---- Sonstiges (nur Gesellschafter) ----
    match /ressourcen/{resourceId} {
      allow read, write: if isOwner();
    }
    match /tickets/{ticketId} {
      allow read, write: if isOwner();
    }
    match /schluessel/{keyId} {
      allow read, write: if isOwner();
    }
  }
}
