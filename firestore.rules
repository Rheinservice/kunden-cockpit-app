rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /customers/{customerId} {
      allow read, write: if request.auth != null;
    }
    match /{path=**}/auftraege/{jobId} {
      allow read, write: if request.auth != null;
    }
    match /{path=**}/objekte/{propertyId} {
      allow read, write: if request.auth != null;
    }
    match /{path=**}/dokumente/{docId} {
      allow read, write: if request.auth != null;
    }
    match /mitarbeiter/{employeeId} {
      allow read, write: if request.auth != null;
    }
    match /{path=**}/abwesenheiten/{absenceId} {
      allow read, write: if request.auth != null;
    }
    match /{path=**}/wiederkehrend/{templateId} {
      allow read, write: if request.auth != null;
    }
    match /nutzer/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /services/{serviceId} {
      allow read, write: if request.auth != null;
    }
    match /material/{materialId} {
      allow read, write: if request.auth != null;
    }
    match /{path=**}/bewegungen/{movementId} {
      allow read, write: if request.auth != null;
    }
    match /{path=**}/wiedervorlagen/{followupId} {
      allow read, write: if request.auth != null;
    }
    match /ressourcen/{resourceId} {
      allow read, write: if request.auth != null;
    }
    match /tickets/{ticketId} {
      allow read, write: if request.auth != null;
    }
    match /schluessel/{keyId} {
      allow read, write: if request.auth != null;
    }
  }
}
