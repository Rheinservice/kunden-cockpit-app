rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isOwner() {
      return request.auth != null && (
        request.auth.token.email in ['info@mi-rheinservice.de'] ||
        (
          firestore.exists(/databases/(default)/documents/nutzer/$(request.auth.uid)) &&
          firestore.get(/databases/(default)/documents/nutzer/$(request.auth.uid)).data.rolle == "Gesellschafter"
        )
      );
    }

    match /customers/{customerId}/dateien/{fileName} {
      allow read, write: if isOwner();
    }

    match /unzugeordnet/dateien/{fileName} {
      allow read, write: if isOwner();
    }
  }
}
